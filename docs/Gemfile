source "https://rubygems.org"

# Vanilla Jekyll (not the `github-pages` meta-gem). The meta-gem hardcodes
# safe mode, which makes Jekyll ignore _plugins/. We deploy via GitHub
# Actions instead (.github/workflows/jekyll.yml), so we get full plugin
# freedom and a modern Jekyll. Run with: bundle exec jekyll serve
gem "jekyll", "~> 4.3"

group :jekyll_plugins do
  gem "jekyll-feed", "~> 0.17"
  gem "jekyll-seo-tag", "~> 2.8"
  gem "jekyll-remote-theme", "~> 0.4"
  gem "jekyll-github-metadata", "~> 2.16"
end

# Windows and JRuby don't ship zoneinfo files.
platforms :windows, :jruby do
  gem "tzinfo", ">= 1", "< 3"
  gem "tzinfo-data"
end

# Watcher for Windows.
gem "wdm", "~> 0.2", :platforms => [:windows]

# Ruby 3.x removed webrick from stdlib; jekyll serve needs it.
gem "webrick", "~> 1.8"

# JRuby compatibility for http_parser.
gem "http_parser.rb", "~> 0.6.0", :platforms => [:jruby]
